# Image source
GHCR_OWNER=your-github-owner-lowercase
IMAGE_TAG=latest

# Database
POSTGRES_DB=voyager
POSTGRES_USER=voyager
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Object storage
MINIO_ROOT_USER=voyager_minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=voyager-documents

# Search
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
OPENSEARCH_DOCUMENT_INDEX=voyager-documents
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_MEM_LIMIT=1536m

# Application secrets. Generate long random values and never commit the real file.
VOYAGER_SECURITY_JWT_SECRET=replace-with-at-least-32-random-characters
VOYAGER_CRYPTO_SECRET=replace-with-at-least-32-random-characters

# Initial production users for an empty database.
VOYAGER_BOOTSTRAP_ADMIN_USERNAME=admin
VOYAGER_BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
VOYAGER_BOOTSTRAP_ADMIN_PASSWORD=12345678
VOYAGER_BOOTSTRAP_EMPLOYEE_USERNAME=employee
VOYAGER_BOOTSTRAP_EMPLOYEE_DISPLAY_NAME=Employee
VOYAGER_BOOTSTRAP_EMPLOYEE_PASSWORD=12345678

# Worker
VOYAGER_WORKER_ID=prod-worker-1
